# Optional services remain fail-closed unless every applicable flag is true.
NEXT_PUBLIC_CONSENT_PLATFORM_ENABLED=false
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_ADSENSE_ACCOUNT_READY=false
NEXT_PUBLIC_ADSENSE_ENABLED=false
# Google Analytics measurement ID. Leave empty to disable
# analytics (analytics also requires the two flags above).
NEXT_PUBLIC_GA_ID=
# Affiliate card links. Leave empty to link to the issuer's public page
# (no commission). After an affiliate program approves the site, paste
# the network-issued URL for each card here and redeploy - no code
# change needed. Supported keys (one per card slug):
#   NEXT_PUBLIC_AFFILIATE_CHASE_SAPPHIRE_PREFERRED
#   NEXT_PUBLIC_AFFILIATE_CHASE_SAPPHIRE_RESERVE
#   NEXT_PUBLIC_AFFILIATE_CHASE_INK_BUSINESS_PREFERRED
#   NEXT_PUBLIC_AFFILIATE_CHASE_FREEDOM_FLEX
#   NEXT_PUBLIC_AFFILIATE_CHASE_FREEDOM_UNLIMITED
#   NEXT_PUBLIC_AFFILIATE_CHASE_UNITED_EXPLORER
#   NEXT_PUBLIC_AFFILIATE_CHASE_WORLD_OF_HYATT
#   NEXT_PUBLIC_AFFILIATE_AMEX_PLATINUM
#   NEXT_PUBLIC_AFFILIATE_AMEX_GOLD
#   NEXT_PUBLIC_AFFILIATE_AMEX_BLUE_CASH_PREFERRED
#   NEXT_PUBLIC_AFFILIATE_AMEX_BUSINESS_PLATINUM
#   NEXT_PUBLIC_AFFILIATE_AMEX_HILTON_ASPIRE
#   NEXT_PUBLIC_AFFILIATE_AMEX_MARRIOTT_BRILLIANT
#   NEXT_PUBLIC_AFFILIATE_CAPITAL_ONE_VENTURE_X
#   NEXT_PUBLIC_AFFILIATE_CAPITAL_ONE_VENTURE
#   NEXT_PUBLIC_AFFILIATE_CAPITAL_ONE_SAVORONE
#   NEXT_PUBLIC_AFFILIATE_CITI_STRATA_PREMIER
#   NEXT_PUBLIC_AFFILIATE_CITI_DOUBLE_CASH
#   NEXT_PUBLIC_AFFILIATE_CITI_CUSTOM_CASH
#   NEXT_PUBLIC_AFFILIATE_DISCOVER_IT_CASH_BACK
NEXT_PUBLIC_AFFILIATE_CHASE_SAPPHIRE_PREFERRED=
# Beehiiv slot-opening reminder form. Leave empty to keep the email
# capture hidden. Set to the publication's subscribe-form URL:
# https://subscribe-forms.beehiiv.com/v3/forms/<form-id>
NEXT_PUBLIC_BEEHIIV_FORM_URL=
