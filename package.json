{
  "name": "524tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:content": "node scripts/content-lint.js",
    "lint:predeploy": "node scripts/predeploy-check.js",
    "test:date-math": "tsx --test scripts/date-math.test.ts",
    "test:core": "tsx --test scripts/date-math.test.ts scripts/tracker-core.test.ts",
    "test:quality": "node scripts/quality-gate.mjs",
    "prebuild": "npm run test:core && npm run test:quality && npm run lint:predeploy && npm run lint:content && npm run lint"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
